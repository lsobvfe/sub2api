# Copy to sub2api.env and fill in real values (sub2api.env is gitignored).
SERVER_HOST=127.0.0.1
SERVER_PORT=18082
SERVER_MODE=release
RUN_MODE=standard
TZ=Asia/Shanghai

DATA_DIR=./data

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me
DATABASE_DBNAME=sub2api
DATABASE_SSLMODE=disable
DATABASE_MAX_OPEN_CONNS=16
DATABASE_MAX_IDLE_CONNS=4
DATABASE_CONN_MAX_LIFETIME_MINUTES=30
DATABASE_CONN_MAX_IDLE_TIME_MINUTES=5

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=4096
REDIS_MIN_IDLE_CONNS=256
REDIS_ENABLE_TLS=false

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
JWT_SECRET=replace-with-long-random-hex
JWT_EXPIRE_HOUR=24
TOTP_ENCRYPTION_KEY=replace-with-64-hex-chars
