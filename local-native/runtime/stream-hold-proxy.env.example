# Public reverse proxy. Sub2API itself must listen only on the upstream URL.
STREAM_HOLD_LISTEN_ADDR=0.0.0.0:18081
STREAM_HOLD_UPSTREAM_URL=http://127.0.0.1:18082
STREAM_HOLD_PATHS=/responses,/v1/responses,/v1/messages,/v1/chat/completions

# Persisted runtime state overrides this startup default.
STREAM_HOLD_ENABLED=true
STREAM_HOLD_STATE_FILE=./stream-hold-proxy-state.json
STREAM_HOLD_SPOOL_DIR=./stream-hold-spool

# Keep the downstream SSE parser active while attempts are retried.
STREAM_HOLD_KEEPALIVE_INTERVAL=5s

# A failed attempt is discarded in full, then retried with bounded backoff.
STREAM_HOLD_RETRY_MIN_INTERVAL=500ms
STREAM_HOLD_RETRY_MAX_INTERVAL=10s
STREAM_HOLD_RETRY_JITTER_RATIO=0.2

# Attempt health boundaries. These never limit the total hold duration.
STREAM_HOLD_RESPONSE_HEADER_TIMEOUT=2m
STREAM_HOLD_STREAM_IDLE_TIMEOUT=90s
STREAM_HOLD_ATTEMPT_MAX_DURATION=15m

# Replay and spool limits.
STREAM_HOLD_MAX_REQUEST_BODY_BYTES=67108864
STREAM_HOLD_MAX_ATTEMPT_BODY_BYTES=536870912
STREAM_HOLD_MAX_SSE_LINE_BYTES=16777216
STREAM_HOLD_MAX_IDLE_CONNS_PER_HOST=256
