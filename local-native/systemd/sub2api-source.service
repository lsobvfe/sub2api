[Unit]
Description=Sub2API Official Source Runtime
Documentation=https://github.com/Wei-Shaw/sub2api
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=blue
Group=blue
WorkingDirectory=/home/blue/proj/Monorepo/third_party/INTEGRATIONS/Wei-Shaw__sub2api/local-native/runtime/work
EnvironmentFile=/home/blue/proj/Monorepo/third_party/INTEGRATIONS/Wei-Shaw__sub2api/local-native/runtime/sub2api.env
Environment=GIN_MODE=release
ExecStart=/home/blue/proj/Monorepo/third_party/INTEGRATIONS/Wei-Shaw__sub2api/local-native/build/sub2api-source
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sub2api-source
LimitNOFILE=100000

[Install]
WantedBy=multi-user.target
